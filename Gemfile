source "https://rubygems.org"

# The github-pages gem pins a 2018-era Jekyll/Liquid that no longer runs on
# modern Ruby (it calls String#tainted?, removed in Ruby 3.2+). This site
# doesn't use any GitHub Pages-specific plugins or themes, so a current
# Jekyll renders it identically while actually working locally.
gem "jekyll", "~> 4.3"
gem "webrick"
gem "liquid"
